# Apply after qrk3588_defconfig, then run olddefconfig.

# This configuration requires a signed FIT and its embedded public key.
CONFIG_CMDLINE=y
CONFIG_HUSH_PARSER=y
CONFIG_CMD_BOOTM=y
CONFIG_CMD_BOOTI=y
CONFIG_BOOTDELAY=-2
# CONFIG_BOOTSTD is not set
# CONFIG_LEGACY_IMAGE_FORMAT is not set
# CONFIG_USE_PREBOOT is not set
CONFIG_ENV_IS_NOWHERE=y
CONFIG_QRK3588_SECURE_OS=y
CONFIG_FIT_SIGNATURE_MAX_SIZE=0x07800000

# Keep the existing secure profile's command and environment footprint.
# CONFIG_CMD_CLK is not set
# CONFIG_CMD_DM is not set
# CONFIG_CMD_GPT is not set
# CONFIG_CMD_MMC is not set
# CONFIG_CMD_PCI is not set
# CONFIG_CMD_PING is not set
# CONFIG_CMD_DHCP is not set
# CONFIG_ENV_IS_IN_MMC is not set
# CONFIG_ENV_REDUNDANT is not set
CONFIG_ENV_SIZE=0x1f000

# Clear development options already materialized by the base configuration.
# CONFIG_ENV_VARS_UBOOT_CONFIG is not set
# CONFIG_SUPPORT_RAW_INITRD is not set
# CONFIG_USE_BOOTCOMMAND is not set
# CONFIG_CMD_MII is not set
# CONFIG_CMD_PXE is not set
# CONFIG_CMD_EXT2 is not set
# CONFIG_CMD_EXT4 is not set
# CONFIG_CMD_FAT is not set
# CONFIG_CMD_FS_GENERIC is not set
# CONFIG_DOS_PARTITION is not set
# CONFIG_ISO_PARTITION is not set
# CONFIG_EFI_PARTITION is not set
# CONFIG_FS_EXT4 is not set
# CONFIG_FS_FAT is not set
# CONFIG_RANDOM_UUID is not set
# CONFIG_CMD_PART is not set
# CONFIG_PXE_UTILS is not set
# CONFIG_MENU is not set
# CONFIG_BOOTP_PXE is not set
# CONFIG_BOOTP_PXE_DHCP_OPTION is not set
# CONFIG_LIB_UUID is not set

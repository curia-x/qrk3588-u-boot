CONFIG_ARM=y
CONFIG_TARGET_QRK3588=y
# OS authentication is opt-in; TF-A firmware authentication is independent.
# CONFIG_QRK3588_SECURE_OS is not set
CONFIG_DEFAULT_DEVICE_TREE="qrk3588"
CONFIG_BOARD_LATE_INIT=y
CONFIG_HUSH_PARSER=y
CONFIG_BOOTSTD_FULL=y
CONFIG_BOOTSTD_DEFAULTS=y

# BL31 owns the SoC reset registers; request reset through PSCI/SMC.
CONFIG_PSCI_RESET=y
CONFIG_SYSRESET=y
CONFIG_SYSRESET_PSCI=y

# Turn it on will cause build failures and runtime panics.
# CONFIG_EFI_LOADER is not set

CONFIG_CMD_CLK=y
CONFIG_CMD_DM=y
CONFIG_CMD_GPT=y
CONFIG_CMD_MMC=y
CONFIG_CMD_PART=y
CONFIG_SHA256=y
CONFIG_PARTITION_TYPE_GUID=y
CONFIG_ENV_IS_IN_MMC=y
CONFIG_ENV_REDUNDANT=y
CONFIG_ENV_OFFSET=0x01600000
CONFIG_ENV_OFFSET_REDUND=0x01610000
CONFIG_ENV_SIZE=0x00010000
CONFIG_ENV_MMC_DEVICE_INDEX=0
CONFIG_ENV_MMC_EMMC_HW_PARTITION=0
CONFIG_BAUDRATE=1500000
CONFIG_DM_SERIAL=y
CONFIG_SYS_NS16550=y
CONFIG_PCI=y
CONFIG_PCI_INIT_R=y
CONFIG_PCIE_DW_QRK3588=y
CONFIG_RTL8169=y
# RTL descriptors share cache lines; allocate them from the uncached pool.
CONFIG_SYS_HAS_NONCACHED_MEMORY=y
CONFIG_NET_RANDOM_ETHADDR=y
CONFIG_CMD_PCI=y
CONFIG_CMD_PING=y
CONFIG_CMD_BOOTI=y
CONFIG_CMD_TFTPBOOT=y
CONFIG_CMD_DHCP=y

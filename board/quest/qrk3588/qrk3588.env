
/* default eth device. */
ethprime=eth1

ipaddr=192.168.1.123
serverip=192.168.1.121
netmask=255.255.255.0
/* Set these to the server export and Linux interface before NFS boot. */
nfsroot=/home/book/source_code/qrk3588/buildroot/output/qrk3588/nfs-root
nfsopts=vers=3,tcp
netdev=eth1
hostname=qrk3588
kernel_file=Image
fdt_file=qrk3588.dtb
autoload=no

/* Raw Image and DTB slots, independent of any boot filesystem. */
bootcmd=run emmc_boot
emmc_boot=run emmc_raw_boot
emmc_raw_boot=mmc dev 0 0 && mmc read ${kernel_addr_r} 0x10000 0x3c000 && mmc read ${fdt_addr_r} 0x4c000 0x1000 && run emmc_args && booti ${kernel_addr_r} - ${fdt_addr_r}
consoleargs=earlycon=uart8250,mmio32,0xfeb50000 console=ttyS2,1500000 keep_bootcon ignore_loglevel loglevel=8
emmcroot=/dev/mmcblk0p3
emmc_args=setenv bootargs ${consoleargs} root=${emmcroot} rw rootwait
nfs_args=setenv bootargs ${consoleargs} root=/dev/nfs rw nfsroot=${serverip}:${nfsroot},${nfsopts} ip=${ipaddr}:${serverip}:${gatewayip}:${netmask}:${hostname}:${netdev}:off
nfs_boot=mmc dev 0 0 && mmc read ${kernel_addr_r} 0x10000 0x3c000 && mmc read ${fdt_addr_r} 0x4c000 0x1000 && run nfs_args && booti ${kernel_addr_r} - ${fdt_addr_r}

/* Compact low-DRAM layout; see docs/boot-memory-layout.rst. */
loadaddr=0x01400000
kernel_addr_r=0x01400000
scriptaddr=0x01000000
pxefile_addr_r=0x01100000
fdt_addr_r=0x01200000
ramdisk_addr_r=0x10000000
update_addr=0x40000000

/*
 * The GPT contains firmware, boot and rootfs. Firmware is a raw storage
 * container for the boot payload and redundant environment; do not format it.
 */
partitions=name=firmware,start=0x8000,size=0x1ff8000,type=ebd0a0a2-b9e5-4433-87c0-68b6b72699c7;
partitions+=name=boot,start=0x2000000,size=0x8000000,type=linux;
partitions+=name=rootfs,start=0xa000000,size=-,type=linux
emmc_gpt_verify=mmc dev 0 && gpt verify mmc 0 ${partitions}
emmc_gpt_write=mmc dev 0 && gpt write mmc 0 ${partitions}
emmc_gpt_list=mmc dev 0 && part list mmc 0
